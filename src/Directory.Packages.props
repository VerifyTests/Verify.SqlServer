    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
    <PackageVersion Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.36.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.181" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="TUnit" Version="1.72.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
    <PackageVersion Include="Verify" Version="33.1.5" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.1.5" />
    <PackageVersion Include="Argon" Version="0.37.0" />
    <PackageVersion Include="DiffEngine" Version="20.5.2" />
    <PackageVersion Include="EmptyFiles" Version="8.19.0" />
